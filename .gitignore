# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.test GİZLİ DEĞİL: içinde canlı anahtar yoktur, bilerek boştur.
# Testlerin canlıya bağlanmamasını sağlayan tek kaynak bu dosya — paylaşılmalı.
!.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# macOS
.DS_Store

# yerel sipariş stub verisi
/.data

# testlerin kök dizine bıraktığı ekran görüntüleri.
# Başındaki "/" YALNIZCA kökü kapsar: public/, assets/, docs/ ve diğer alt
# klasörlerdeki görseller ETKİLENMEZ (ürün fotoğrafları oradan geliyor).
# 20 Eyl 2026: png dışı uzantılar da eklendi — kökte 70 PNG birikmişti.
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif
/*.avif

# İşletmenin ham çekim arşivi (135 JPG, ~2,4 GB) — repoya GİRMEZ.
# Galeriye giren kareler public/galeri/ altına işlenmiş (WebP) olarak konur.
/mag-foto

# canlı veritabanı yedekleri — kişisel veri içerebilir, ASLA commitlenmez
/docs/backup

# Doğrulama ekran görüntüleri — KOD DEĞİL, repoda tutulmuyor (17 Eyl 2026).
# Dosyalar diskte kalmaya devam eder ve yeni kareler buraya yazılır; sadece git
# izlemez. Geçmişteki eski kareler .git içinde duruyor (~496 MB) — onları
# temizlemek geçmişi yeniden yazmak demek, bilerek YAPILMADI.
/docs/screens
.e2e-lock
