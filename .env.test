# Test ortamı — CANLI VERİTABANINA HİÇ BAĞLANMAZ.
#
# Burada bilerek SUPABASE_* anahtarı YOKTUR: lib/env.ts hasSupabaseServer()
# false döner ve depo dosya tabanlı stub'a (.data/*.json) düşer. Yani testler
# canlı orders tablosuna tek satır yazamaz.
#
# .env.local'i EZMEK için test komutları --env-file=.env.test ile çalışır ve
# scripts/test-guard.mjs canlı bir Supabase URL'i görürse testi durdurur.

NODE_ENV=production
PANEL_KEY=test1234
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_SECRET=test-only-mock-secret-do-not-use-in-production
MAG_FAKE_NOW=2026-09-03T12:00:00+03:00
NEXT_PUBLIC_SITE_URL=http://localhost:3112

# Supabase anahtarları KASITLI OLARAK BOŞ — doldurma.
# Canlıya karşı test gerekiyorsa bu dosya değil, ayrı bir test PROJESİ kullanılmalı.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
